# Public release: documentation and final installers only. No source/build inputs.
# Everything else stays local unless explicitly admitted below.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.*
!/COPYING
!/NOTICE

# Public reference documents; private folders or other future files remain excluded.
!/docs/
/docs/*
!/docs/LORE_README.md
!/docs/TRANSFORMATIONS_ALQC_WORDS.md
!/docs/DICTIONARY_ALQC_WORDS.md
!/docs/Aksharam_Legend.md
!/docs/the_shape_of_word.txt

# Only final installers may leave the private build directory.
!/build/
/build/*

# Public installers for the three supported package targets.
!/build/linux_ubuntu/
/build/linux_ubuntu/*
!/build/linux_ubuntu/aksharam_glyphkey.kmp
!/build/windows/
/build/windows/*
!/build/windows/aksharam_glyphkey.kmp
!/build/mac/
/build/mac/*
!/build/mac/aksharam_glyphkey.kmp
