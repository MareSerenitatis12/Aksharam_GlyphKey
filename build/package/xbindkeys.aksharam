  Alt+Shift + Return

"python3 $HOME/.local/share/keyman/aksharam_glyphkey/aksharam_host_controls.py single"
  Alt+Shift + BackSpace

"python3 $HOME/.local/share/keyman/aksharam_glyphkey/aksharam_host_controls.py unfold"
  Alt + BackSpace

"python3 $HOME/.local/share/keyman/aksharam_glyphkey/aksharam_host_controls.py refold"
